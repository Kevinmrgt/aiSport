# URL du backend Hono
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth.js — OWASP A02: secret uniquement en variable d'env
AUTH_SECRET=your_auth_secret_here_same_as_api

# OAuth GitHub
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# URL publique de l'app (pour les callbacks OAuth)
NEXTAUTH_URL=http://localhost:3000

# Secret interne service-to-service (partagé avec apps/api — OWASP A01)
SERVICE_SECRET=generate_a_random_secret_here_same_as_api
