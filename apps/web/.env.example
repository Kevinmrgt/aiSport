# URL du backend Hono pour les appels exécutés côté serveur Next.js
API_URL=http://localhost:3001

# URL publique autorisée par la politique CSP
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth.js — OWASP A02: secret uniquement en variable d'env
AUTH_SECRET=generate_a_random_secret_here

# OAuth Google
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# URL publique de l'app (pour les callbacks OAuth)
NEXTAUTH_URL=http://localhost:3000

# Secret interne service-to-service (partagé avec apps/api — OWASP A01)
SERVICE_SECRET=generate_a_random_secret_here_same_as_api

# Informations reelles a configurer avant ouverture ; ne pas inventer de coordonnees.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_HOSTING_NAME=
LEGAL_HOSTING_CONTACT=
LEGAL_PROCESSING_BASIS=
LEGAL_TRANSFERS_NOTICE=
# Meme politique que l'API ; le script de purge doit etre planifie et verifie.
RETENTION_INACTIVE_DAYS=365
# APP_REVISION=SHA_GIT_COMPLET_FOURNI_PAR_CI
