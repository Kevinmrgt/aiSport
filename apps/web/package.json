{
  "name": "web",
  "version": "0.13.0-rc.8",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/home.spec.ts tests/e2e/auth.spec.ts tests/e2e/accessibility.spec.ts tests/e2e/axe.spec.ts",
    "test:e2e:evidence": "playwright test tests/e2e/browser-evidence.spec.ts",
    "test:e2e:auth:browser": "node scripts/e2e-auth-preflight.mjs capture && node scripts/e2e-auth-launch-browser.mjs",
    "test:e2e:auth:capture": "node scripts/e2e-auth-preflight.mjs capture && node scripts/e2e-auth-capture-cdp.mjs",
    "test:e2e:authenticated": "node scripts/e2e-auth-preflight.mjs run && playwright test --config=playwright.auth.config.ts",
    "test:e2e:accessibility-native-zoom": "node scripts/e2e-native-zoom-audit.mjs",
    "test:e2e:accessibility-contrast-details": "node scripts/e2e-contrast-incomplete-audit.mjs",
    "evidence:rncp-prototype": "node scripts/capture-rncp-prototype.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alcide/shared": "workspace:*",
    "next": "^15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
