{
  "buildCommand": "cd ../.. && pnpm --filter shared build && pnpm --filter api build",
  "outputDirectory": "public",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --prod=false",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs api",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
