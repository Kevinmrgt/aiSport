# Base de données PostgreSQL
DATABASE_URL=postgresql://alcide:alcide_dev@localhost:5432/alcide

# OpenAI API - OWASP A02: jamais en clair dans le code
OPENAI_API_KEY=your_openai_api_key_here

# Secret interne service-to-service (partagé avec apps/web — OWASP A01)
SERVICE_SECRET=generate_a_random_secret_here

# Serveur
PORT=3001
NODE_ENV=development

# Frontend URL (pour CORS — OWASP A05)
FRONTEND_URL=http://localhost:3000

# Preparation de production : valeurs finies et partagees par toutes les instances.
# Les valeurs initiales limitent des tokens/appels, pas une facture en euros.
AI_ALLOWED_MODELS=gpt-5.4-mini
AI_DEFAULT_MODEL=gpt-5.4-mini
AI_USER_DAILY_ATTEMPTS=16
AI_GLOBAL_DAILY_ATTEMPTS=200
AI_USER_DAILY_TOKENS=160000
AI_GLOBAL_DAILY_TOKENS=2000000
AI_USER_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=4
AI_GENERATION_LEASE_SECONDS=120
AI_RESERVED_INPUT_TOKENS=16384
AI_MAX_COMPLETION_TOKENS=2048
AI_GENERATION_ENABLED=true
RETENTION_INACTIVE_DAYS=365
# Secret de revocation distinct recommande ; sa rotation exige une strategie de sessions.
# PRIVACY_REVOCATION_SECRET=
# APP_REVISION=SHA_GIT_COMPLET_FOURNI_PAR_CI
PRODUCTION_ACCESS_MODE=public
ADMIN_EMAILS=
# BOOTSTRAP_ADMIN_USER_ID is only configured by the controlled admin release.
