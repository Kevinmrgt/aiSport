# Base de données PostgreSQL
DATABASE_URL=postgresql://alcide:alcide_dev@localhost:5432/alcide

# OpenAI API - OWASP A02: jamais en clair dans le code
OPENAI_API_KEY=your_openai_api_key_here

# Auth.js — secret pour signer les sessions (OWASP A07)
AUTH_SECRET=your_auth_secret_here_generate_with_openssl_rand_hex_32

# Secret interne service-to-service (partagé avec apps/web — OWASP A01)
SERVICE_SECRET=generate_a_random_secret_here

# Serveur
PORT=3001
NODE_ENV=development

# Frontend URL (pour CORS — OWASP A05)
FRONTEND_URL=http://localhost:3000
