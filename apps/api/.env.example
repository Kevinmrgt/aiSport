# Base de données PostgreSQL
DATABASE_URL=postgresql://sportcoach:sportcoach_dev@localhost:5432/sportcoach_ia

# Mistral AI — OWASP A02: jamais en clair dans le code
MISTRAL_API_KEY=your_mistral_api_key_here

# Auth.js — secret pour signer les sessions (OWASP A07)
AUTH_SECRET=your_auth_secret_here_generate_with_openssl_rand_hex_32

# OAuth providers (ex: GitHub)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Serveur
PORT=3001
NODE_ENV=development

# Frontend URL (pour CORS — OWASP A05)
FRONTEND_URL=http://localhost:3000
