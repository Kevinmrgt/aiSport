# ──────────────────────────────────────────────────────────────────────────────
# Alcide — Variables d'environnement (exemple)
# Copier ce fichier en .env à la racine pour docker-compose
# OWASP A02: ne jamais commiter les vraies valeurs
# ──────────────────────────────────────────────────────────────────────────────

# ─── Secrets partagés API + Web ───────────────────────────────────────────────
# Générer avec: openssl rand -hex 32
SERVICE_SECRET=

# ─── API Hono ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Frontend Next.js ─────────────────────────────────────────────────────────
# Auth.js — Générer avec: openssl rand -hex 32
AUTH_SECRET=

# OAuth Google — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL interne utilisée par le serveur Next.js dans Docker
API_URL=http://api:3001

# URLs accessibles depuis le navigateur hôte
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Playwright authentifié (compte Google de test dédié uniquement) ─────────
# Ces valeurs ne sont pas requises pour lancer l'application.
# Le storageState contient une session active : son emplacement est ignoré par Git.
E2E_BASE_URL=https://ai-sport-web.vercel.app
E2E_AUTH_EMAIL=
PLAYWRIGHT_AUTH_STORAGE=playwright/.auth/google-e2e.json

# Preparation de production : voir docs/generation-budgets.md et privacy-operations.md.
AI_ALLOWED_MODELS=gpt-5.4-mini
AI_DEFAULT_MODEL=gpt-5.4-mini
AI_USER_DAILY_ATTEMPTS=16
AI_GLOBAL_DAILY_ATTEMPTS=200
AI_USER_DAILY_TOKENS=160000
AI_GLOBAL_DAILY_TOKENS=2000000
AI_USER_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=4
AI_GENERATION_ENABLED=true
RETENTION_INACTIVE_DAYS=365
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_HOSTING_NAME=
LEGAL_HOSTING_CONTACT=
LEGAL_PROCESSING_BASIS=
LEGAL_TRANSFERS_NOTICE=
