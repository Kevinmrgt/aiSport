# ──────────────────────────────────────────────────────────────────────────────
# Alcide — Variables d'environnement (exemple)
# Copier ce fichier en .env à la racine pour docker-compose
# OWASP A02: ne jamais commiter les vraies valeurs
# ──────────────────────────────────────────────────────────────────────────────

# ─── Secrets partagés API + Web ───────────────────────────────────────────────
# Générer avec: openssl rand -hex 32
SERVICE_SECRET=

# ─── API Hono ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Frontend Next.js ─────────────────────────────────────────────────────────
# Auth.js — Générer avec: openssl rand -hex 32
AUTH_SECRET=

# OAuth Google — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URLs publiques
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Playwright authentifié (compte Google de test dédié uniquement) ─────────
# Ces valeurs ne sont pas requises pour lancer l'application.
# Le storageState contient une session active : son emplacement est ignoré par Git.
E2E_BASE_URL=https://ai-sport-web.vercel.app
E2E_AUTH_EMAIL=
PLAYWRIGHT_AUTH_STORAGE=playwright/.auth/google-e2e.json
