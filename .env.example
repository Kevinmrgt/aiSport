# ──────────────────────────────────────────────────────────────────────────────
# Alcide — Variables d'environnement (exemple)
# Copier ce fichier en .env à la racine pour docker-compose
# OWASP A02: ne jamais commiter les vraies valeurs
# ──────────────────────────────────────────────────────────────────────────────

# ─── Secrets partagés API + Web ───────────────────────────────────────────────
# Générer avec: openssl rand -hex 32
SERVICE_SECRET=change_me_generate_with_openssl_rand_hex_32

# ─── API Hono ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Frontend Next.js ─────────────────────────────────────────────────────────
# Auth.js — Générer avec: openssl rand -hex 32
AUTH_SECRET=change_me_generate_with_openssl_rand_hex_32

# OAuth Google — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# URLs publiques
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
